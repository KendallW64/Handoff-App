{
  "name": "handoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:pages": "npm run build && playwright test --config playwright.pages.config.ts",
    "test:live": "playwright test --config playwright.live.config.ts",
    "backend:dev": "wrangler dev",
    "backend:deploy": "wrangler deploy",
    "test:backend": "node --test server/worker.test.mjs",
    "check:backend": "tsc -p tsconfig.server.json",
    "test:gemini": "playwright test --config playwright.gemini.config.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "html-entities": "^2.6.0",
    "lucide-react": "^0.468.0",
    "postal-mime": "^4.0.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "pdf-lib": "^1.17.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "wrangler": "^4.151.1"
  }
}
