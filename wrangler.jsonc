{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "handoff-app",
  "main": "server/worker.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "vars": {
    "ENABLE_GEMINI": "true",
    "ALLOWED_ORIGIN": "https://kendallw64.github.io",
    "GEMINI_MODEL": "gemini-3.8-flash",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "handoff-ai-usage",
      "database_id": "8b99de08-bc00-4e29-883b-e6dfa385b2b4",
      "migrations_dir": "server/migrations",
    },
  ],
}
